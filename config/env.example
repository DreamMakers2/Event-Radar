# Copy this file to config/env.sh. The destination is ignored by Git.
# Keep real credentials, cookies, chat identifiers, and private endpoints out of version control.

export EVENT_RADAR_APP_HOST='127.0.0.1'
export EVENT_RADAR_APP_PORT='8089'
export EVENT_RADAR_DATABASE_PATH='var/event_radar.db'
export EVENT_RADAR_LOG_LEVEL='INFO'

export EVENT_RADAR_OPENAI_API_KEY=''
export EVENT_RADAR_OPENAI_ADMIN_KEY=''
export EVENT_RADAR_OPENAI_MODEL='gpt-5-mini'
export EVENT_RADAR_OPENAI_USAGE_PROJECT_NAME='Event Radar'
export EVENT_RADAR_OPENAI_USAGE_API_KEY_NAME='Event Radar'

export EVENT_RADAR_X_BEARER_TOKEN=''
export EVENT_RADAR_X_STREAM_ENABLED='true'

# Configure either a cookie file or an inline cookie value for Truth Social.
export EVENT_RADAR_TRUTH_SOCIAL_COOKIE_FILE=''
# export EVENT_RADAR_TRUTH_SOCIAL_COOKIE=''
export EVENT_RADAR_TRUTH_SOCIAL_POLL_SECONDS='3'

# Event Radar talks to an HTTP relay; it does not call Telegram directly.
export EVENT_RADAR_TELEGRAM_RELAY_BASE_URL='http://127.0.0.1:8080'
export EVENT_RADAR_TELEGRAM_RELAY_API_KEY=''
export EVENT_RADAR_TELEGRAM_RELAY_CHAT_ID=''

# Keep this true while validating a new installation.
export EVENT_RADAR_ALERT_DRY_RUN='true'
